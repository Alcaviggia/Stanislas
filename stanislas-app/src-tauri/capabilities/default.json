{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "fs:default",
    "fs:allow-resource-write",
    "fs:allow-resource-write-recursive",
    "fs:allow-temp-write",
    "fs:allow-temp-write-recursive",
    "fs:allow-document-write",
    "fs:allow-document-write-recursive",
    "fs:allow-mkdir",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        },
        {
          "name": "ollama",
          "cmd": "ollama",
          "args": true
        },
        {
          "name": "zsh",
          "cmd": "zsh",
          "args": true
        },
        {
          "name": "caffeinate",
          "cmd": "caffeinate",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        },
        {
          "name": "ollama",
          "cmd": "ollama",
          "args": true
        },
        {
          "name": "zsh",
          "cmd": "zsh",
          "args": true
        },
        {
          "name": "caffeinate",
          "cmd": "caffeinate",
          "args": true
        }
      ]
    },
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Documents/Stanislas/**"
        },
        {
          "path": "$HOME/AppData/Roaming/Stanislas/**"
        }
      ]
    }
  ]
}